<UserControl x:Class="Pomidoro.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pomidoro.Views"
             xmlns:loc="clr-namespace:Pomidoro.Localization">

    <Border Style="{StaticResource PanelBorder}" Padding="18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Text TodayCaption}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding HoursText}" Style="{StaticResource TotalText}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding CountText}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Bottom"
                           Margin="12,0,0,6" />
            </Grid>

            <views:SessionListView Grid.Row="1" DataContext="{Binding List}" />
        </Grid>
    </Border>
</UserControl>
