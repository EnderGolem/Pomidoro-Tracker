<Window x:Class="Pomidoro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pomidoro.Views"
        xmlns:loc="clr-namespace:Pomidoro.Localization"
        Title="{loc:Text AppTitle}"
        Width="520" Height="780" MinWidth="460" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <Grid>
        <!-- Таймер и сегодняшний день -->
        <Grid Margin="18" Visibility="{Binding IsTimerVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button x:Name="SettingsButton"
                        HorizontalAlignment="Left"
                        Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        Command="{Binding ToggleSettingsCommand}"
                        AutomationProperties.Name="{loc:Text SettingsName}"
                        ToolTip="{loc:Text SettingsTip}" />

                <Button HorizontalAlignment="Right"
                        Style="{StaticResource HeaderButton}"
                        Content="{loc:Text StatsButton}"
                        Command="{Binding ShowStatsCommand}" />
            </Grid>

            <views:TimerView Grid.Row="1" DataContext="{Binding Timer}" Margin="0,14,0,0" />
            <views:TodayView Grid.Row="2" DataContext="{Binding Today}" Margin="0,14,0,0" />
        </Grid>

        <!-- Статистика -->
        <Grid Margin="18" Visibility="{Binding IsStatsVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button HorizontalAlignment="Left"
                        Style="{StaticResource IconButton}"
                        Content="&#xE72B;"
                        Command="{Binding ShowTimerCommand}"
                        AutomationProperties.Name="{loc:Text BackToTimer}"
                        ToolTip="{loc:Text BackToTimer}" />

                <TextBlock Text="{loc:Text StatsCaption}"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <views:StatsView Grid.Row="1" DataContext="{Binding Stats}" Margin="0,14,0,0" />
        </Grid>

        <!-- Меню под шестерёнкой -->
        <Popup PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}">
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black" />
                </Border.Effect>

                <views:SettingsView DataContext="{Binding Settings}" />
            </Border>
        </Popup>
    </Grid>
</Window>
