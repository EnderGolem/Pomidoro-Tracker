<Window x:Class="Pomidoro.Views.SqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Pomidoro.Localization"
        Title="{loc:Text SqlConsole}"
        Width="900" Height="620" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnWindowKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DatabasePath}"
                   Style="{StaticResource CaptionText}"
                   FontWeight="Normal"
                   TextTrimming="CharacterEllipsis"
                   Margin="2,0,2,8" />

        <Border Grid.Row="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6,4">
            <TextBox x:Name="QueryBox"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     SpellCheck.IsEnabled="False"
                     AutomationProperties.Name="{loc:Text QueryName}"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{loc:Text RunButton}"
                    Style="{StaticResource PrimaryButton}"
                    Height="32"
                    Padding="18,0"
                    FontSize="13"
                    ToolTip="{loc:Text RunTip}"
                    Click="OnRunClick" />

            <Button Grid.Column="2"
                    Content="{loc:Text ClearButton}"
                    Style="{StaticResource FlatButton}"
                    Height="32"
                    Padding="14,0"
                    FontSize="13"
                    Command="{Binding ClearCommand}" />

            <TextBlock Grid.Column="3"
                       Text="{Binding Status}"
                       Style="{StaticResource CaptionText}"
                       FontWeight="Normal"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="12,0,2,0" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{loc:Text SqlWarning}"
                   Style="{StaticResource CaptionText}"
                   FontWeight="Normal"
                   TextWrapping="Wrap"
                   Margin="2,10,2,0" />

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="6"
                Padding="8,6"
                Margin="0,10,0,0">
            <TextBox Text="{Binding Output, Mode=OneWay}"
                     Background="Transparent"
                     Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AutomationProperties.Name="{loc:Text ResultName}"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</Window>
