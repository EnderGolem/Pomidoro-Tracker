<UserControl x:Class="Pomidoro.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Pomidoro.Views"
             xmlns:loc="clr-namespace:Pomidoro.Localization">

    <Border Style="{StaticResource PanelBorder}" Padding="18,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="4,0">
                <ComboBox ItemsSource="{Binding Periods}"
                          SelectedItem="{Binding SelectedPeriod}"
                          Style="{StaticResource PeriodCombo}"
                          AutomationProperties.Name="{loc:Text PeriodName}"
                          ToolTip="{loc:Text PeriodTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Border>

            <Grid Grid.Row="1" Margin="2,14,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding HoursText}" Style="{StaticResource TotalText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,6">
                    <TextBlock Text="{Binding CountText}"
                               Style="{StaticResource CaptionText}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding MedianText}"
                               Style="{StaticResource CaptionText}"
                               FontSize="10"
                               FontWeight="Normal"
                               Opacity="0.75"
                               TextAlignment="Right"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- Chart. The grid lies under the bars and isn't hit-testable, so
                 it doesn't intercept their tooltips. -->
            <Border x:Name="ChartHost"
                    Grid.Row="2"
                    Height="190"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="10,10,10,6"
                    Margin="0,14,0,0"
                    SizeChanged="OnChartHostSizeChanged">
                <Grid>
                    <TextBlock Text="{loc:Text ChartEmpty}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding GridLines}"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding GridWidth}" Height="{Binding ChartHeight}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="0" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />

                                    <Border Grid.Column="1"
                                            Width="{Binding LineWidth}"
                                            Height="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BorderBrush}"
                                            Opacity="{Binding Opacity}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ScrollViewer Margin="36,0,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Columns}"
                                      VerticalAlignment="Bottom"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="ColumnRoot"
                                                Width="{Binding Width}"
                                                Margin="1,0"
                                                VerticalAlignment="Bottom"
                                                ToolTip="{Binding Tooltip}"
                                                ToolTipService.InitialShowDelay="200"
                                                ToolTipService.BetweenShowDelay="0">
                                        <Grid Height="{Binding PlotHeight}">
                                            <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Fill}"
                                                                Height="{Binding Height}"
                                                                CornerRadius="2"
                                                                Margin="0,1,0,0"
                                                                ToolTip="{Binding Tooltip}"
                                                                ToolTipService.InitialShowDelay="200"
                                                                ToolTipService.BetweenShowDelay="0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>

                                        <TextBlock Text="{Binding Label}"
                                                   Style="{StaticResource CaptionText}"
                                                   FontSize="10"
                                                   TextAlignment="Center"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <!-- Weekends are dimmed: they show where the work week ends -->
                                        <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                            <Setter TargetName="ColumnRoot" Property="Opacity" Value="0.75" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding Legend}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LegendChip}"
                                Command="{Binding DataContext.ToggleTypeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{loc:Text LegendTip}"
                                ToolTipService.InitialShowDelay="1000"
                                ToolTipService.BetweenShowDelay="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{Binding Fill}" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Display}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />

                                <TextBlock Text="{Binding Hours}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <views:SessionListView Grid.Row="4" DataContext="{Binding List}" />
        </Grid>
    </Border>
</UserControl>
