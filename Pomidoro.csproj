<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pomidoro</AssemblyName>
    <RootNamespace>Pomidoro</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    The language is chosen at build time: AppLanguage=en produces the English version.
    There is no runtime switch; the Russian and English versions ship as
    separate files.

    The constant is added by a target, not by a conditional PropertyGroup: the property may
    come from a publish profile, and the profile is imported only after
    the .csproj body has been evaluated. The target runs after the imports and sees it.
  -->
  <Target Name="AddLanguageConstant" BeforeTargets="BeforeCompile" Condition="'$(AppLanguage)' == 'en'">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);ENGLISH</DefineConstants>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!--
      WinForms is referenced only for NotifyIcon: WPF has no tray icon of its own.
      WinForms implicit usings are removed, otherwise its Button, TextBox and MessageBox
      conflict with the same-named WPF types throughout the project.
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pomidoro.Tests" />
  </ItemGroup>

</Project>
