<?xml version="1.0" encoding="utf-8"?>
<!--
  A single exe of about 2.4 MB, but the machine needs the
  .NET 9 Desktop Runtime installed. Fine when distributing to yourself or wherever
  the runtime is known to be present.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>publish\framework\</PublishDir>
  </PropertyGroup>
</Project>
