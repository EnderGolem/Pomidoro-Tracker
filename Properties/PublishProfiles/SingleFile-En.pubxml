<?xml version="1.0" encoding="utf-8"?>
<!--
  English version. AppLanguage=en enables the ENGLISH constant,
  which Localization/Loc.cs uses to pick EnglishStrings.

  A single exe that runs on a machine without .NET installed.
  Weighs about 72 MB: the runtime itself is packed inside, and it can't be shrunk much —
  PublishTrimmed is not supported with WPF.

  IncludeNativeLibrariesForSelfExtract is needed because of SQLite: it brings the native
  e_sqlite3.dll, which would otherwise sit next to the exe as a separate file.
  The database is still created next to the exe, not in the temporary extraction folder.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <AppLanguage>en</AppLanguage>
    <PublishDir>publish\en\</PublishDir>
  </PropertyGroup>
</Project>
