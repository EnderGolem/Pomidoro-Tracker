<?xml version="1.0" encoding="utf-8"?>
<!--
  Английская версия. AppLanguage=en включает константу ENGLISH,
  которой Localization/Loc.cs выбирает EnglishStrings.

  Один exe, который работает на машине без установленного .NET.
  Весит примерно 72 МБ: внутрь упакован сам рантайм, и ужать сильно не выйдет —
  PublishTrimmed с WPF не поддерживается.

  IncludeNativeLibrariesForSelfExtract нужен из-за SQLite: он тащит нативный
  e_sqlite3.dll, который иначе остался бы лежать рядом с exe отдельным файлом.
  База при этом всё равно создаётся рядом с exe, а не во временной папке распаковки.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <AppLanguage>en</AppLanguage>
    <PublishDir>publish\en\</PublishDir>
  </PropertyGroup>
</Project>
