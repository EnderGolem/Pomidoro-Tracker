<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The only place in the app where colors are defined. Markup and code
         use only the names from here. -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1B1D24" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF262A35" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1F222B" />
    <SolidColorBrush x:Key="WellBrush" Color="#FF15171D" />

    <SolidColorBrush x:Key="ControlBrush" Color="#FF333848" />
    <SolidColorBrush x:Key="ControlQuietBrush" Color="#FF272A35" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF2B2F3C" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FFE5484D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33E5484D" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#55E5484D" />
    <SolidColorBrush x:Key="RestBrush" Color="#FF3DBE8B" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFEDEEF2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8D91A0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF343947" />

    <SolidColorBrush x:Key="ThumbBrush" Color="#FF3C4354" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#FF4E5668" />
    <SolidColorBrush x:Key="ThumbDragBrush" Color="#FF5F6A80" />

</ResourceDictionary>
